# Copie para .env (que NÃO vai para o Git) e troque as senhas.
# Em produção estes valores vêm do SSM, nunca de arquivo versionado.

# Postgres local (superusuário só da sua máquina)
POSTGRES_PASSWORD=troque-esta-senha
# Usuário do Keycloak no banco: acesso só ao schema "keycloak" (A7)
KEYCLOAK_DB_PASSWORD=troque-esta-senha

# Administrador do Keycloak (console em http://localhost:8180/auth/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha

# Endereço público do Keycloak (o "issuer" dos tokens)
KC_HOSTNAME=http://localhost:8180/auth

# Cliente OIDC do commerce-bff-nani (B2.2). Gere um segredo longo:
#   openssl rand -base64 32
COMMERCE_BFF_CLIENT_SECRET=troque-este-segredo
COMMERCE_BFF_REDIRECT_URI=http://localhost:4200/login/oauth2/code/nani
COMMERCE_BFF_POST_LOGOUT_URI=http://localhost:4200/

# E-mail: no desenvolvimento vai para o Mailpit (http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=nao-responda@naniperfumes.com.br

# Senha das contas de teste criadas pelo seed (só desenvolvimento)
DEV_USERS_PASSWORD=12345678
